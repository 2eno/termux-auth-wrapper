# =============================================================================
# termux-auth-wrapper – Konfiguration
# Pfad: ~/.config/termux-auth-wrapper/config.conf
#
# Format: SCHLÜSSEL=wert  (einfache/doppelte Anführungszeichen erlaubt)
# Die Datei wird NICHT als Shell-Code ausgeführt, sondern geparst. Erlaubt
# sind nur die unten aufgeführten Schlüssel; ~, $HOME und $PREFIX werden
# ersetzt. Jeder Schlüssel lässt sich pro Aufruf per Umgebungsvariable
# TAW_<SCHLÜSSEL> überschreiben, z. B.:  TAW_DEBUG=true sudo id
# =============================================================================

# --- Biometrie ---------------------------------------------------------------
# Titel des Android-Fingerabdruckdialogs
BIO_TITLE="Termux-Authentifizierung"
# Max. Wartezeit (Sekunden) auf den Dialog. Schützt auch davor, dass Aufrufe
# ewig hängen, wenn die App "Termux:API" fehlt.
BIO_TIMEOUT=30
# Wie oft der Dialog bei "nicht erkannt/abgebrochen" erneut erscheint
BIO_MAX_ATTEMPTS=2
# Titel/Beschreibung (-t/-d) an termux-fingerprint übergeben.
# Auf false setzen, falls die installierte termux-api-Version das nicht kann.
BIO_DIALOG_TEXT=true

# --- Auth-Cache (Gnadenfrist, wie sudo "timestamp_timeout") -----------------
# Sekunden, die eine erfolgreiche Authentifizierung gültig bleibt.
# 0 = jedes Mal Fingerabdruck verlangen.
AUTH_CACHE_TIMEOUT=300
# session = pro Terminal-Sitzung (Termux-Tab); Skripte erben die Sitzung
# global  = gilt für alle Sitzungen (praktisch für Hintergrundjobs)
AUTH_CACHE_SCOPE=session
# true = ein gemeinsamer Cache für sudo UND ssh; false = getrennt
AUTH_CACHE_SHARED=false
# Wie lange parallele Aufrufe auf einen laufenden Dialog warten (Sekunden)
LOCK_TIMEOUT=120

# --- Fallbacks ---------------------------------------------------------------
# Was passiert, wenn Biometrie NICHT VERFÜGBAR ist (kein Sensor, kein
# Fingerabdruck eingerichtet, Termux:API fehlt, Timeout)?
#   none  = Zugriff verweigern (empfohlen, "fail closed")
#   pin   = eigene Fallback-PIN abfragen (setzen mit: termux-auth set-pin)
#   allow = ohne Authentifizierung durchlassen  (UNSICHER, nur zum Debuggen)
FALLBACK_MODE=none
# Fallback auch nach ABGELEHNTEM/abgebrochenem Fingerabdruck anbieten?
FALLBACK_ON_REJECT=false
# Wird von "termux-auth set-pin" gesetzt (Format sha256:SALT:HASH)
FALLBACK_PIN_HASH=""

# --- sudo --------------------------------------------------------------------
SUDO_ENABLED=true
# Pfad zu su; "auto" sucht /system/bin/su (KernelSU), /data/adb/ksu/bin/su, …
SU_BINARY=auto
# Termux-Umgebung (PATH, PREFIX, TERM, LD_PRELOAD) an die Root-Seite übergeben
SUDO_PRESERVE_TERMUX_ENV=true
# HOME für root: suroot (= ~/.suroot, wie tsu), keep (= dein HOME) oder ein Pfad
SUDO_HOME=suroot
# Shell für "sudo", "sudo -s", "sudo -i": auto = $PREFIX/bin/bash
SUDO_SHELL=auto
# KernelSU "--mount-master" (globaler Mount-Namespace) verwenden
SUDO_MOUNT_MASTER=false
# Warnen, wenn pkg/apt/dpkg per sudo gestartet wird
SUDO_WARN_PKG=true

# --- ssh ---------------------------------------------------------------------
SSH_ENABLED=true
# Pfad zum echten ssh; "auto" = gesichertes Original bzw. $PATH-Suche
SSH_BINARY=auto
# all    = vor JEDER ssh-Verbindung Fingerabdruck
# mapped = nur bei Hosts, die in ssh-hosts.conf eingetragen sind
SSH_AUTH_SCOPE=all
# Leerzeichengetrennte Host-Muster OHNE Fingerabdruck (z. B. für git)
SSH_SKIP_HOSTS=""
# Übergabe privater Schlüssel aus Bitwarden:
#   auto = ssh-agent, falls erreichbar, sonst temporäre Datei
#   agent / tempfile
SSH_KEY_METHOD=auto
# Lebensdauer (Sekunden) eines per ssh-add geladenen Schlüssels
SSH_AGENT_KEY_LIFETIME=300

# --- Bitwarden CLI (bw) ------------------------------------------------------
# Zugangsdaten für Hosts aus ssh-hosts.conf über Bitwarden beziehen
BW_ENABLED=false
# Gesperrter Tresor: prompt = Master-Passwort im Terminal abfragen
#                    never  = abbrechen (BW_SESSION muss exportiert sein)
BW_UNLOCK_MODE=prompt
# BW_SESSION in ~/.local/state/termux-auth-wrapper/bw-session (0600) merken
# Bequemer, aber: wer diese Datei liest, kann den Tresor lesen.
BW_SESSION_CACHE=false
# Zeitlimit für bw-Aufrufe (Sekunden)
BW_TIMEOUT=60
# Vor dem Abruf "bw sync" ausführen (langsamer, dafür aktuell)
BW_SYNC=false
# Wenn Bitwarden nicht liefert: prompt = normal weiter (ssh fragt selbst)
#                               fail   = Verbindung abbrechen
BW_FALLBACK=prompt

# --- Allgemein ---------------------------------------------------------------
# Audit-Log unter ~/.local/state/termux-auth-wrapper/audit.log
AUDIT_LOG=true
# Vollständige sudo-Befehlszeilen loggen (können Geheimnisse enthalten!)
AUDIT_LOG_ARGS=false
DEBUG=false
# auto | always | never
COLOR=auto
