# =============================================================================
# termux-auth-wrapper – configuration
# Path: ~/.config/termux-auth-wrapper/config.conf
#
# Format: KEY=value  (single/double quotes allowed)
# The file is NOT executed as shell code but parsed. Only the keys listed
# below are allowed; ~, $HOME and $PREFIX are substituted. Every key can be
# overridden per call with the environment variable TAW_<KEY>, e.g.:
#   TAW_DEBUG=true sudo id
# =============================================================================

# --- Biometrics --------------------------------------------------------------
# Title of the Android fingerprint dialog
BIO_TITLE="Termux authentication"
# Max. wait (seconds) for the dialog. Also prevents calls from hanging
# forever if the "Termux:API" app is missing.
BIO_TIMEOUT=30
# How often the dialog reappears after "not recognized/cancelled"
BIO_MAX_ATTEMPTS=2
# Pass title/description (-t/-d) to termux-fingerprint.
# Set to false if the installed termux-api version can't handle it.
BIO_DIALOG_TEXT=true

# --- Auth cache (grace period, like sudo's "timestamp_timeout") --------------
# Seconds a successful authentication stays valid.
# 0 = ask for the fingerprint every time.
AUTH_CACHE_TIMEOUT=300
# session = per terminal session (Termux tab); scripts inherit the session
# global  = applies to all sessions (handy for background jobs)
AUTH_CACHE_SCOPE=session
# true = one shared cache for sudo AND ssh; false = separate
AUTH_CACHE_SHARED=false
# How long parallel calls wait for a running dialog (seconds)
LOCK_TIMEOUT=120

# --- Fallbacks ---------------------------------------------------------------
# What happens if biometrics are NOT AVAILABLE (no sensor, no fingerprint
# enrolled, Termux:API missing, timeout)?
#   none  = deny access (recommended, "fail closed")
#   pin   = ask for your own fallback PIN (set it with: termux-auth set-pin)
#   allow = let it through without authentication  (INSECURE, debugging only)
FALLBACK_MODE=none
# Also offer the fallback after a REJECTED/cancelled fingerprint?
FALLBACK_ON_REJECT=false
# Set by "termux-auth set-pin" (format sha256:SALT:HASH)
FALLBACK_PIN_HASH=""

# --- sudo --------------------------------------------------------------------
SUDO_ENABLED=true
# Path to su; "auto" searches /system/bin/su (KernelSU), /data/adb/ksu/bin/su, …
SU_BINARY=auto
# Pass the Termux environment (PATH, PREFIX, TERM, LD_PRELOAD) to the root side
SUDO_PRESERVE_TERMUX_ENV=true
# HOME for root: suroot (= ~/.suroot, like tsu), keep (= your HOME) or a path
SUDO_HOME=suroot
# Shell for "sudo", "sudo -s", "sudo -i": auto = $PREFIX/bin/bash
SUDO_SHELL=auto
# Use KernelSU "--mount-master" (global mount namespace)
SUDO_MOUNT_MASTER=false
# Warn when pkg/apt/dpkg is started with sudo
SUDO_WARN_PKG=true

# --- ssh ---------------------------------------------------------------------
SSH_ENABLED=true
# Path to the real ssh; "auto" = saved original or $PATH search
SSH_BINARY=auto
# all    = fingerprint before EVERY ssh connection
# mapped = only for hosts listed in ssh-hosts.conf
SSH_AUTH_SCOPE=all
# Space-separated host patterns WITHOUT fingerprint (e.g. for git)
SSH_SKIP_HOSTS=""
# How private keys from Bitwarden are handed over:
#   auto = ssh-agent if reachable, otherwise a temporary file
#   agent / tempfile
SSH_KEY_METHOD=auto
# Lifetime (seconds) of a key loaded with ssh-add
SSH_AGENT_KEY_LIFETIME=300

# --- Bitwarden CLI (bw) ------------------------------------------------------
# Get credentials for hosts from ssh-hosts.conf from Bitwarden
BW_ENABLED=false
# Locked vault: prompt = ask for the master password in the terminal
#               never  = abort (BW_SESSION must be exported)
BW_UNLOCK_MODE=prompt
# Remember BW_SESSION in ~/.local/state/termux-auth-wrapper/bw-session (0600)
# More convenient, but: whoever can read this file can read the vault.
BW_SESSION_CACHE=false
# Time limit for bw calls (seconds)
BW_TIMEOUT=60
# Run "bw sync" before fetching (slower, but up to date)
BW_SYNC=false
# If Bitwarden delivers nothing: prompt = continue normally (ssh asks itself)
#                                fail   = abort the connection
BW_FALLBACK=prompt

# --- General -----------------------------------------------------------------
# Audit log at ~/.local/state/termux-auth-wrapper/audit.log
AUDIT_LOG=true
# Log full sudo command lines (may contain secrets!)
AUDIT_LOG_ARGS=false
DEBUG=false
# auto | always | never
COLOR=auto
