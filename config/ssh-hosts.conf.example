# =============================================================================
# termux-auth-wrapper – mapping SSH host -> Bitwarden item
# Path: ~/.config/termux-auth-wrapper/ssh-hosts.conf
#
# Format (one mapping per line, the first match wins):
#
#   <host-pattern>   <bitwarden-item>   [password|key|auto]
#
#   host-pattern    glob pattern, matched against the alias from the command
#                   line, the resolved host name (~/.ssh/config) and user@host.
#   bitwarden-item  item ID (recommended, unique) or a name in "…" .
#                   Find the ID: bw list items --search "Name" | jq -r '.[].id'
#   type            password = login password -> sshpass
#                   key      = private key (Bitwarden SSH key item, custom
#                              field "ssh_private_key" or a note)
#                   auto     = key preferred, otherwise password (default)
#
# Requires: BW_ENABLED=true in config.conf
# Can be overridden per call:  TAW_BW_ITEM=<id> TAW_BW_TYPE=key ssh host
# =============================================================================

# Examples:
# homeserver            0b8c5d6e-1111-2222-3333-abcdefabcdef   password
# pi@192.168.178.*      "Raspberry Pi"                         password
# *.example.org         7f3e2a10-4444-5555-6666-abcdefabcdef   key
# admin@vps             "VPS Root Key"                         auto
