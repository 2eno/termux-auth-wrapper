#!/usr/bin/env bash
# TERMUX_AUTH_WRAPPER_MARKER
# shellcheck disable=SC2153  # TAW_*-Werte stammen aus taw_load_config
# =============================================================================
# sudo – Fingerabdruck-geschützter sudo-Ersatz für Termux + KernelSU
#
# Führt nach erfolgreicher biometrischer Authentifizierung den Befehl via
# KernelSU (su -c) als root aus. Funktioniert interaktiv und aus Skripten,
# stdin/stdout/stderr und der Exit-Code werden unverändert durchgereicht.
#
#   sudo [-E] [-n] [-k] [-u BENUTZER] [-s|-i] [--] [VAR=wert ...] [BEFEHL ...]
#   sudo -v | -k | -K | -h | -V
# =============================================================================
set -euo pipefail

TAW_COMPONENT="sudo"
_taw_lib="@TAW_LIB_DIR@"
[[ -d $_taw_lib ]] || _taw_lib="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib"
# shellcheck source=lib/auth.sh
source "$_taw_lib/auth.sh" || { echo "[sudo] Fehler: Bibliothek nicht gefunden ($_taw_lib) – bitte install.sh erneut ausführen." >&2; exit 1; }

usage() {
    cat <<EOF
Aufruf: sudo [Optionen] [--] [VAR=wert ...] BEFEHL [ARGUMENTE ...]

Führt BEFEHL nach Fingerabdruck-Bestätigung als root (KernelSU) aus.

Optionen:
  -u, --user BENUTZER      als BENUTZER statt root ausführen
  -E, --preserve-env       gesamte Umgebung an su übergeben (su -p)
  -s, --shell              Befehl über eine Shell ausführen / Root-Shell öffnen
  -i, --login              Login-Shell als root
  -n, --non-interactive    nie einen Dialog zeigen; nur gültigen Auth-Cache nutzen
  -k, --reset-timestamp    Auth-Cache verwerfen (mit BEFEHL: für diesen Aufruf ignorieren)
  -K, --remove-timestamp   alle Auth-Caches löschen
  -v, --validate           nur authentifizieren und Cache auffrischen
  -h, --help               diese Hilfe
  -V, --version            Version

termux-auth-wrapper $TAW_VERSION – Konfiguration: $TAW_CONFIG_FILE
EOF
}

# --- KernelSU / su finden ----------------------------------------------------
find_su() {
    if [[ -n $TAW_SU_BINARY && $TAW_SU_BINARY != auto ]]; then
        [[ -x $TAW_SU_BINARY ]] && { printf '%s' "$TAW_SU_BINARY"; return 0; }
        taw_err "SU_BINARY='$TAW_SU_BINARY' ist nicht ausführbar."
        return 1
    fi
    # KernelSU fängt execve() auf /system/bin/su ab (für freigegebene Apps).
    local c
    for c in /system/bin/su /data/adb/ksu/bin/su /system/xbin/su /sbin/su \
             /debug_ramdisk/su /su/bin/su; do
        [[ -x $c ]] && { printf '%s' "$c"; return 0; }
    done
    return 1
}

# --- Argumente ---------------------------------------------------------------
opt_user="" opt_env=false opt_shell=false opt_login=false opt_nonint=false
opt_reset=false opt_remove=false opt_validate=false

while (($#)); do
    case $1 in
        -u|--user)
            [[ $# -ge 2 ]] || taw_die "Option $1 benötigt einen Benutzernamen."
            opt_user=$2; shift 2; continue ;;
        --user=*)            opt_user=${1#*=} ;;
        -E|--preserve-env)   opt_env=true ;;
        -s|--shell)          opt_shell=true ;;
        -i|--login)          opt_login=true ;;
        -n|--non-interactive) opt_nonint=true ;;
        -k|--reset-timestamp) opt_reset=true ;;
        -K|--remove-timestamp) opt_remove=true ;;
        -v|--validate)       opt_validate=true ;;
        -h|--help)           usage; exit 0 ;;
        -V|--version)        printf 'termux-auth-wrapper sudo %s\n' "$TAW_VERSION"; exit 0 ;;
        --)                  shift; break ;;
        -[!-]?*)
            # Kombinierte Kurzoptionen wie -Es aufspalten
            _rest=${1#-}; shift
            _split=()
            while [[ -n $_rest ]]; do
                _split+=("-${_rest:0:1}")
                # -u mit angehängtem Wert (-uroot)
                if [[ ${_rest:0:1} == u && ${#_rest} -gt 1 ]]; then
                    _split+=("${_rest:1}"); _rest=""; break
                fi
                _rest=${_rest:1}
            done
            set -- "${_split[@]}" "$@"
            continue ;;
        -*)
            taw_die "Nicht unterstützte Option: $1 (siehe sudo --help)" ;;
        *)  break ;;
    esac
    shift
done

taw_load_config

if [[ $opt_remove == true ]]; then
    taw_cache_clear_all
    (($#)) || exit 0
fi

# -k ohne Befehl: nur Cache verwerfen (wie beim echten sudo)
if [[ $opt_reset == true && $# -eq 0 && $opt_validate == false && $opt_shell == false && $opt_login == false ]]; then
    taw_cache_clear sudo
    exit 0
fi

if ! taw_is_true "$TAW_SUDO_ENABLED"; then
    taw_die "Der sudo-Wrapper ist deaktiviert (SUDO_ENABLED=false in $TAW_CONFIG_FILE)."
fi

SU_BIN=$(find_su) || {
    taw_err "Kein su-Binary gefunden. Ist KernelSU aktiv und Termux in der KernelSU-App als Root-App freigegeben?"
    taw_hint "Alternativ den Pfad in der Konfiguration setzen: SU_BINARY=/pfad/zu/su"
    exit 1
}
taw_debug "su: $SU_BIN"

# --- Authentifizierung -------------------------------------------------------
desc_cmd="Root-Shell"
(($#)) && desc_cmd=$*
(( ${#desc_cmd} > 160 )) && desc_cmd="${desc_cmd:0:157}..."
if taw_is_true "$TAW_AUDIT_LOG_ARGS"; then
    TAW_AUDIT_DETAIL="user=${opt_user:-root} cmd=$desc_cmd"
else
    TAW_AUDIT_DETAIL="user=${opt_user:-root} cmd=${1:-<shell>}"
fi

if ! taw_authenticate sudo "sudo ${opt_user:+(-u $opt_user) }– $desc_cmd" "$opt_nonint" "$opt_reset"; then
    taw_die "Authentifizierung fehlgeschlagen – Befehl wird NICHT ausgeführt." 1
fi
[[ $opt_validate == true && $# -eq 0 ]] && exit 0

# --- Root-Befehl zusammenbauen -----------------------------------------------
# Auf der Root-Seite läuft /system/bin/sh (mksh); daher POSIX-Quoting.
env_part=""
if taw_is_true "$TAW_SUDO_PRESERVE_TERMUX_ENV"; then
    case $TAW_SUDO_HOME in
        keep)    root_home=$HOME ;;
        suroot)  root_home="$HOME/.suroot" ;;
        *)       root_home=$TAW_SUDO_HOME ;;
    esac
    root_path="$TAW_PREFIX/bin:/system/bin:/system/xbin:/sbin:/vendor/bin"
    env_part="export PATH=$(taw_shell_quote "$root_path")"
    env_part+=" PREFIX=$(taw_shell_quote "$TAW_PREFIX")"
    env_part+=" HOME=$(taw_shell_quote "$root_home")"
    env_part+=" TMPDIR=$(taw_shell_quote "${TMPDIR:-$TAW_PREFIX/tmp}")"
    env_part+=" TERM=$(taw_shell_quote "${TERM:-xterm-256color}")"
    env_part+=" LANG=$(taw_shell_quote "${LANG:-en_US.UTF-8}")"
    [[ -n ${LD_PRELOAD:-} ]] && env_part+=" LD_PRELOAD=$(taw_shell_quote "$LD_PRELOAD")"
    [[ -n ${COLORTERM:-} ]] && env_part+=" COLORTERM=$(taw_shell_quote "$COLORTERM")"
    env_part+="; mkdir -p \"\$HOME\" 2>/dev/null; "
fi

# Führende VAR=wert-Zuweisungen (sudo FOO=bar befehl)
while (($#)) && [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; do
    env_part+="export ${1%%=*}=$(taw_shell_quote "${1#*=}"); "
    shift
done

if [[ -n $TAW_SUDO_SHELL && $TAW_SUDO_SHELL != auto ]]; then
    root_shell=$TAW_SUDO_SHELL
elif [[ -x $TAW_PREFIX/bin/bash ]]; then
    root_shell="$TAW_PREFIX/bin/bash"
else
    root_shell=/system/bin/sh
fi

if [[ $opt_login == true ]]; then
    if (($#)); then
        run_part="exec $(taw_shell_quote "$root_shell") -l -c $(taw_shell_quote "$(taw_shell_join "$@")")"
    else
        run_part="exec $(taw_shell_quote "$root_shell") -l"
    fi
elif (($# == 0)); then
    run_part="exec $(taw_shell_quote "$root_shell")"
elif [[ $opt_shell == true ]]; then
    run_part="exec $(taw_shell_quote "$root_shell") -c $(taw_shell_quote "$*")"
else
    if taw_is_true "$TAW_SUDO_WARN_PKG"; then
        case ${1##*/} in
            pkg|apt|apt-get|dpkg)
                taw_warn "'$1' als root kann die Dateirechte von Termux beschädigen – normalerweise ohne sudo ausführen." ;;
        esac
    fi
    run_part="exec $(taw_shell_join "$@")"
fi

su_args=()
[[ $opt_env == true ]] && su_args+=(-p)
taw_is_true "$TAW_SUDO_MOUNT_MASTER" && su_args+=(-M)
[[ -n $opt_user && $opt_user != root && $opt_user != 0 ]] && su_args+=("$opt_user")
su_args+=(-c "${env_part}${run_part}")

taw_debug "exec $SU_BIN ${su_args[*]}"
exec "$SU_BIN" "${su_args[@]}"
