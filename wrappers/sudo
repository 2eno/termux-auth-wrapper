#!/usr/bin/env bash
# TERMUX_AUTH_WRAPPER_MARKER
# shellcheck disable=SC2153  # TAW_* values come from taw_load_config
# =============================================================================
# sudo – fingerprint-protected sudo replacement for Termux + KernelSU
#
# After successful biometric authentication, runs the command as root via
# KernelSU (su -c). Works interactively and from scripts; stdin/stdout/stderr
# and the exit code are passed through unchanged.
#
#   sudo [-E] [-n] [-k] [-u USER] [-s|-i] [--] [VAR=value ...] [COMMAND ...]
#   sudo -v | -k | -K | -h | -V
# =============================================================================
set -euo pipefail

TAW_COMPONENT="sudo"
_taw_lib="@TAW_LIB_DIR@"
[[ -d $_taw_lib ]] || _taw_lib="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib"
# shellcheck source=lib/auth.sh
source "$_taw_lib/auth.sh" || { echo "[sudo] error: library not found ($_taw_lib) – please run install.sh again." >&2; exit 1; }

usage() {
    cat <<EOF
Usage: sudo [options] [--] [VAR=value ...] COMMAND [ARGUMENTS ...]

Runs COMMAND as root (KernelSU) after fingerprint confirmation.

Options:
  -u, --user USER          run as USER instead of root
  -E, --preserve-env       pass the whole environment to su (su -p)
  -s, --shell              run the command through a shell / open a root shell
  -i, --login              login shell as root
  -n, --non-interactive    never show a dialog; only use a valid auth cache
  -k, --reset-timestamp    discard the auth cache (with COMMAND: ignore it for this call)
  -K, --remove-timestamp   delete all auth caches
  -v, --validate           only authenticate and refresh the cache
  -h, --help               this help
  -V, --version            version

termux-auth-wrapper $TAW_VERSION – config: $TAW_CONFIG_FILE
EOF
}

# --- Find KernelSU / su ------------------------------------------------------
find_su() {
    if [[ -n $TAW_SU_BINARY && $TAW_SU_BINARY != auto ]]; then
        [[ -x $TAW_SU_BINARY ]] && { printf '%s' "$TAW_SU_BINARY"; return 0; }
        taw_err "SU_BINARY='$TAW_SU_BINARY' is not executable."
        return 1
    fi
    # KernelSU intercepts execve() on /system/bin/su (for granted apps).
    local c
    for c in /system/bin/su /data/adb/ksu/bin/su /system/xbin/su /sbin/su \
             /debug_ramdisk/su /su/bin/su; do
        [[ -x $c ]] && { printf '%s' "$c"; return 0; }
    done
    return 1
}

# --- Arguments ---------------------------------------------------------------
opt_user="" opt_env=false opt_shell=false opt_login=false opt_nonint=false
opt_reset=false opt_remove=false opt_validate=false

while (($#)); do
    case $1 in
        -u|--user)
            [[ $# -ge 2 ]] || taw_die "Option $1 requires a user name."
            opt_user=$2; shift 2; continue ;;
        --user=*)            opt_user=${1#*=} ;;
        -E|--preserve-env)   opt_env=true ;;
        -s|--shell)          opt_shell=true ;;
        -i|--login)          opt_login=true ;;
        -n|--non-interactive) opt_nonint=true ;;
        -k|--reset-timestamp) opt_reset=true ;;
        -K|--remove-timestamp) opt_remove=true ;;
        -v|--validate)       opt_validate=true ;;
        -h|--help)           usage; exit 0 ;;
        -V|--version)        printf 'termux-auth-wrapper sudo %s\n' "$TAW_VERSION"; exit 0 ;;
        --)                  shift; break ;;
        -[!-]?*)
            # Split combined short options like -Es
            _rest=${1#-}; shift
            _split=()
            while [[ -n $_rest ]]; do
                _split+=("-${_rest:0:1}")
                # -u with an attached value (-uroot)
                if [[ ${_rest:0:1} == u && ${#_rest} -gt 1 ]]; then
                    _split+=("${_rest:1}"); _rest=""; break
                fi
                _rest=${_rest:1}
            done
            set -- "${_split[@]}" "$@"
            continue ;;
        -*)
            taw_die "Unsupported option: $1 (see sudo --help)" ;;
        *)  break ;;
    esac
    shift
done

taw_load_config

if [[ $opt_remove == true ]]; then
    taw_cache_clear_all
    (($#)) || exit 0
fi

# -k without a command: only discard the cache (like the real sudo)
if [[ $opt_reset == true && $# -eq 0 && $opt_validate == false && $opt_shell == false && $opt_login == false ]]; then
    taw_cache_clear sudo
    exit 0
fi

if ! taw_is_true "$TAW_SUDO_ENABLED"; then
    taw_die "The sudo wrapper is disabled (SUDO_ENABLED=false in $TAW_CONFIG_FILE)."
fi

SU_BIN=$(find_su) || {
    taw_err "No su binary found. Is KernelSU active and Termux granted root in the KernelSU app?"
    taw_hint "Alternatively set the path in the config: SU_BINARY=/path/to/su"
    exit 1
}
taw_debug "su: $SU_BIN"

# --- Authentication ----------------------------------------------------------
desc_cmd="root shell"
(($#)) && desc_cmd=$*
(( ${#desc_cmd} > 160 )) && desc_cmd="${desc_cmd:0:157}..."
if taw_is_true "$TAW_AUDIT_LOG_ARGS"; then
    TAW_AUDIT_DETAIL="user=${opt_user:-root} cmd=$desc_cmd"
else
    TAW_AUDIT_DETAIL="user=${opt_user:-root} cmd=${1:-<shell>}"
fi

if ! taw_authenticate sudo "sudo ${opt_user:+(-u $opt_user) }– $desc_cmd" "$opt_nonint" "$opt_reset"; then
    taw_die "Authentication failed – the command will NOT be run." 1
fi
[[ $opt_validate == true && $# -eq 0 ]] && exit 0

# --- Build the root command --------------------------------------------------
# The root side runs /system/bin/sh (mksh); hence POSIX quoting.
env_part=""
if taw_is_true "$TAW_SUDO_PRESERVE_TERMUX_ENV"; then
    case $TAW_SUDO_HOME in
        keep)    root_home=$HOME ;;
        suroot)  root_home="$HOME/.suroot" ;;
        *)       root_home=$TAW_SUDO_HOME ;;
    esac
    root_path="$TAW_PREFIX/bin:/system/bin:/system/xbin:/sbin:/vendor/bin"
    env_part="export PATH=$(taw_shell_quote "$root_path")"
    env_part+=" PREFIX=$(taw_shell_quote "$TAW_PREFIX")"
    env_part+=" HOME=$(taw_shell_quote "$root_home")"
    env_part+=" TMPDIR=$(taw_shell_quote "${TMPDIR:-$TAW_PREFIX/tmp}")"
    env_part+=" TERM=$(taw_shell_quote "${TERM:-xterm-256color}")"
    env_part+=" LANG=$(taw_shell_quote "${LANG:-en_US.UTF-8}")"
    [[ -n ${LD_PRELOAD:-} ]] && env_part+=" LD_PRELOAD=$(taw_shell_quote "$LD_PRELOAD")"
    [[ -n ${COLORTERM:-} ]] && env_part+=" COLORTERM=$(taw_shell_quote "$COLORTERM")"
    env_part+="; mkdir -p \"\$HOME\" 2>/dev/null; "
fi

# Leading VAR=value assignments (sudo FOO=bar command)
while (($#)) && [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; do
    env_part+="export ${1%%=*}=$(taw_shell_quote "${1#*=}"); "
    shift
done

if [[ -n $TAW_SUDO_SHELL && $TAW_SUDO_SHELL != auto ]]; then
    root_shell=$TAW_SUDO_SHELL
elif [[ -x $TAW_PREFIX/bin/bash ]]; then
    root_shell="$TAW_PREFIX/bin/bash"
else
    root_shell=/system/bin/sh
fi

if [[ $opt_login == true ]]; then
    if (($#)); then
        run_part="exec $(taw_shell_quote "$root_shell") -l -c $(taw_shell_quote "$(taw_shell_join "$@")")"
    else
        run_part="exec $(taw_shell_quote "$root_shell") -l"
    fi
elif (($# == 0)); then
    run_part="exec $(taw_shell_quote "$root_shell")"
elif [[ $opt_shell == true ]]; then
    run_part="exec $(taw_shell_quote "$root_shell") -c $(taw_shell_quote "$*")"
else
    if taw_is_true "$TAW_SUDO_WARN_PKG"; then
        case ${1##*/} in
            pkg|apt|apt-get|dpkg)
                taw_warn "'$1' as root can break Termux file permissions – normally run it without sudo." ;;
        esac
    fi
    run_part="exec $(taw_shell_join "$@")"
fi

su_args=()
[[ $opt_env == true ]] && su_args+=(-p)
taw_is_true "$TAW_SUDO_MOUNT_MASTER" && su_args+=(-M)
[[ -n $opt_user && $opt_user != root && $opt_user != 0 ]] && su_args+=("$opt_user")
su_args+=(-c "${env_part}${run_part}")

taw_debug "exec $SU_BIN ${su_args[*]}"
exec "$SU_BIN" "${su_args[@]}"
