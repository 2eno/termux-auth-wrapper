#!/usr/bin/env bash
# TERMUX_AUTH_WRAPPER_MARKER
# shellcheck disable=SC2153  # TAW_*-Werte stammen aus taw_load_config
# =============================================================================
# ssh – Fingerabdruck-geschützter ssh-Wrapper mit optionaler Bitwarden-Anbindung
#
#   1. Ziel ermitteln (inkl. ~/.ssh/config-Aliasse via "ssh -G")
#   2. Fingerabdruck (bzw. gültiger Auth-Cache)
#   3. Falls dem Host ein Bitwarden-Eintrag zugeordnet ist (ssh-hosts.conf):
#        Passwort  -> sshpass (über Dateideskriptor, nicht in argv/env)
#        Schlüssel -> ssh-agent (ssh-add -t) oder temporäre Datei (0600)
#   4. echtes ssh mit unveränderten Argumenten ausführen
#
# Per-Aufruf-Überschreibung:  TAW_BW_ITEM=<id|name> [TAW_BW_TYPE=password|key] ssh host
# Exit-Codes wie ssh: 255 bei Verbindungs-/Authentifizierungsfehlern.
# =============================================================================
set -euo pipefail

TAW_COMPONENT="ssh"
_taw_lib="@TAW_LIB_DIR@"
[[ -d $_taw_lib ]] || _taw_lib="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib"
# shellcheck source=lib/auth.sh
source "$_taw_lib/auth.sh" || { echo "[ssh] Fehler: Bibliothek nicht gefunden ($_taw_lib) – bitte install.sh erneut ausführen." >&2; exit 255; }
# shellcheck source=lib/bitwarden.sh
source "$_taw_lib/bitwarden.sh"

taw_load_config

REAL_SSH=$(taw_find_real ssh "$TAW_SSH_BINARY") || {
    taw_err "Das echte ssh-Binary wurde nicht gefunden."
    taw_hint "Installation: pkg install openssh   (danach ggf. 'termux-auth repair')"
    exit 255
}
taw_debug "echtes ssh: $REAL_SSH"

passthrough() { exec "$REAL_SSH" "$@"; }

taw_is_true "$TAW_SSH_ENABLED" || passthrough "$@"

# --- Argumente analysieren ---------------------------------------------------
# Optionen von OpenSSH, die ein Argument erwarten
_SSH_OPTS_WITH_ARG="BbcDEeFIiJLlmOoPpQRSWw"
SSH_DEST=""
SSH_NOCONNECT=false     # -V, -G, -Q, -O: keine neue Verbindung -> kein Dialog

parse_ssh_args() {
    local arg flags ch i
    while (($#)); do
        arg=$1
        case $arg in
            --) shift; [[ $# -gt 0 ]] && SSH_DEST=$1; return 0 ;;
            -?*)
                flags=${arg#-}
                for (( i = 0; i < ${#flags}; i++ )); do
                    ch=${flags:i:1}
                    case $ch in V|G|Q|O) SSH_NOCONNECT=true ;; esac
                    if [[ $_SSH_OPTS_WITH_ARG == *"$ch"* ]]; then
                        # Argument direkt angehängt (-p22) oder als nächstes Wort
                        (( i + 1 < ${#flags} )) || shift
                        break
                    fi
                done ;;
            *)  SSH_DEST=$arg; return 0 ;;
        esac
        shift || true
    done
}

(($#)) || passthrough
parse_ssh_args "$@"
if [[ $SSH_NOCONNECT == true || -z $SSH_DEST ]]; then
    passthrough "$@"
fi

# Ziel auflösen: ssh -G wertet ~/.ssh/config, -l, -p usw. korrekt aus
dest_alias=${SSH_DEST#*@}
dest_alias=${dest_alias#ssh://}
dest_user=""
[[ $SSH_DEST == *@* ]] && dest_user=${SSH_DEST%%@*}
res_host=$dest_alias
res_user=${dest_user:-${USER:-$(id -un)}}
res_port=22
if resolved=$("$REAL_SSH" -G "$@" 2>/dev/null </dev/null); then
    while read -r k v; do
        case $k in
            hostname) res_host=$v ;;
            user)     res_user=$v ;;
            port)     res_port=$v ;;
        esac
    done <<<"$resolved"
fi
taw_debug "Ziel: alias=$dest_alias host=$res_host user=$res_user port=$res_port"

host_matches() {
    # $1 = Muster (Glob), prüft gegen Alias, Hostname und user@host
    local pat=$1
    # shellcheck disable=SC2053  # Glob-Vergleich ist beabsichtigt
    [[ $dest_alias == $pat || $res_host == $pat || "$res_user@$res_host" == $pat || "$res_user@$dest_alias" == $pat ]]
}

# Hosts ohne Biometrie (z. B. github.com für git)
read -ra _skip_hosts <<<"$TAW_SSH_SKIP_HOSTS"
for _pat in "${_skip_hosts[@]}"; do
    if host_matches "$_pat"; then
        taw_debug "Host passt auf SSH_SKIP_HOSTS ($_pat) – kein Dialog"
        passthrough "$@"
    fi
done

# --- Bitwarden-Zuordnung suchen ----------------------------------------------
BW_ITEM=${TAW_BW_ITEM:-}
BW_TYPE=${TAW_BW_TYPE:-auto}
if [[ -z $BW_ITEM && -f $TAW_HOSTS_FILE ]]; then
    _lineno=0
    while IFS= read -r _line || [[ -n $_line ]]; do
        _lineno=$((_lineno + 1))
        _line=${_line%$'\r'}
        [[ $_line =~ ^[[:space:]]*(#.*)?$ ]] && continue
        if [[ $_line =~ ^[[:space:]]*([^[:space:]]+)[[:space:]]+(\"[^\"]+\"|[^[:space:]\"]+)([[:space:]]+([a-z]+))?[[:space:]]*(#.*)?$ ]]; then
            _pat=${BASH_REMATCH[1]}
            _item=${BASH_REMATCH[2]}
            _type=${BASH_REMATCH[4]:-auto}
            if host_matches "$_pat"; then
                _item=${_item#\"}; BW_ITEM=${_item%\"}
                BW_TYPE=$_type
                taw_debug "Zuordnung $TAW_HOSTS_FILE:$_lineno ($_pat) -> Bitwarden-Item"
                break
            fi
        else
            taw_warn "Ungültige Zeile $TAW_HOSTS_FILE:$_lineno – ignoriert"
        fi
    done <"$TAW_HOSTS_FILE"
fi

if [[ $TAW_SSH_AUTH_SCOPE == mapped && -z $BW_ITEM ]]; then
    taw_debug "SSH_AUTH_SCOPE=mapped und keine Zuordnung – kein Dialog"
    passthrough "$@"
fi

# --- Authentifizierung -------------------------------------------------------
target="$res_user@$res_host"
[[ $res_port != 22 ]] && target+=":$res_port"
TAW_AUDIT_DETAIL="target=$target"
if ! taw_authenticate ssh "SSH-Verbindung zu $target"; then
    taw_die "Authentifizierung fehlgeschlagen – SSH-Verbindung wird NICHT aufgebaut." 255
fi

# Ohne Bitwarden: normales ssh (Schlüssel/Agent/Passwortabfrage wie gewohnt)
if [[ -z $BW_ITEM ]] || ! taw_is_true "$TAW_BW_ENABLED"; then
    [[ -n $BW_ITEM ]] && taw_debug "Zuordnung vorhanden, aber BW_ENABLED=false"
    passthrough "$@"
fi

if ! taw_bw_get_secret "$BW_ITEM" "$BW_TYPE"; then
    if [[ $TAW_BW_FALLBACK == prompt ]]; then
        taw_warn "Fahre ohne Bitwarden fort – ssh fragt ggf. selbst nach Passwort/Passphrase."
        passthrough "$@"
    fi
    taw_die "Zugangsdaten aus Bitwarden nicht verfügbar (BW_FALLBACK=fail) – Abbruch." 255
fi

# --- Passwort via sshpass ----------------------------------------------------
if [[ $TAW_BW_SECRET_TYPE == password ]]; then
    if ! SSHPASS_BIN=$(command -v sshpass 2>/dev/null); then
        TAW_BW_SECRET=""
        if [[ $TAW_BW_FALLBACK == prompt ]]; then
            taw_warn "sshpass nicht installiert (pkg install sshpass) – ssh fragt selbst nach dem Passwort."
            passthrough "$@"
        fi
        taw_die "sshpass nicht installiert: pkg install sshpass" 255
    fi
    _pw=$TAW_BW_SECRET
    TAW_BW_SECRET=""
    # Passwort über FD 3 (Pipe) – taucht weder in argv noch in der Umgebung auf
    exec "$SSHPASS_BIN" -d 3 "$REAL_SSH" -o NumberOfPasswordPrompts=1 "$@" 3< <(printf '%s\n' "$_pw")
fi

# --- Privater Schlüssel ------------------------------------------------------
_key=$TAW_BW_SECRET
TAW_BW_SECRET=""
[[ $_key == *$'\n' ]] || _key+=$'\n'

agent_usable() {
    [[ -n ${SSH_AUTH_SOCK:-} && -S $SSH_AUTH_SOCK ]] || return 1
    command -v ssh-add >/dev/null 2>&1 || return 1
    local rc=0
    ssh-add -l >/dev/null 2>&1 </dev/null || rc=$?
    (( rc != 2 ))      # 2 = keine Verbindung zum Agenten
}

method=$TAW_SSH_KEY_METHOD
if [[ $method == auto ]]; then
    if agent_usable; then method=agent; else method=tempfile; fi
fi

if [[ $method == agent ]]; then
    if ! agent_usable; then
        taw_die "SSH_KEY_METHOD=agent, aber kein erreichbarer ssh-agent (SSH_AUTH_SOCK)." 255
    fi
    if printf '%s' "$_key" | ssh-add -q -t "$TAW_SSH_AGENT_KEY_LIFETIME" - 2>/dev/null; then
        _key=""
        taw_debug "Schlüssel für ${TAW_SSH_AGENT_KEY_LIFETIME}s in ssh-agent geladen"
        passthrough "$@"
    fi
    _key=""
    taw_die "ssh-add konnte den Schlüssel aus Bitwarden nicht laden (verschlüsselt oder ungültiges Format?)." 255
fi

# tempfile: Schlüssel in eine private Datei, nach Ende von ssh sicher löschen
taw_ensure_dir "$TAW_RUNTIME_DIR" 700
keyfile=$(umask 077; mktemp "$TAW_RUNTIME_DIR/sshkey.XXXXXX")
# shellcheck disable=SC2329  # wird über trap aufgerufen
cleanup() {
    if [[ -n ${keyfile:-} && -f $keyfile ]]; then
        # überschreiben, dann löschen
        local size
        size=$(wc -c <"$keyfile" 2>/dev/null || echo 4096)
        head -c "$size" /dev/zero >"$keyfile" 2>/dev/null || true
        rm -f "$keyfile"
    fi
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 143' TERM
# INT/QUIT nicht abbrechen lassen (ssh behandelt Strg+C selbst); ':' statt ''
# damit ssh die Signale NICHT als ignoriert erbt.
trap ':' INT QUIT

printf '%s' "$_key" >"$keyfile"
_key=""
rc=0
"$REAL_SSH" -i "$keyfile" -o IdentitiesOnly=yes "$@" || rc=$?
exit "$rc"
