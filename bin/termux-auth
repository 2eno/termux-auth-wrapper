#!/usr/bin/env bash
# TERMUX_AUTH_WRAPPER_MARKER
# shellcheck disable=SC2153  # TAW_*-Werte stammen aus taw_load_config
# =============================================================================
# termux-auth – Verwaltungswerkzeug für termux-auth-wrapper
# =============================================================================
set -euo pipefail

TAW_COMPONENT="termux-auth"
_taw_lib="@TAW_LIB_DIR@"
[[ -d $_taw_lib ]] || _taw_lib="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib"
# shellcheck source=lib/auth.sh
source "$_taw_lib/auth.sh" || { echo "[termux-auth] Fehler: Bibliothek nicht gefunden ($_taw_lib)" >&2; exit 1; }
# shellcheck source=lib/bitwarden.sh
source "$_taw_lib/bitwarden.sh"
# shellcheck source=lib/install-lib.sh
source "$_taw_lib/install-lib.sh"

usage() {
    cat <<EOF
Aufruf: termux-auth <Befehl> [Optionen]

Befehle:
  status            Installationszustand, Abhängigkeiten und Konfiguration anzeigen
  doctor            wie status, zusätzlich Live-Prüfungen (su, Bitwarden)
  diag              Schritt-für-Schritt-Diagnose der Termux:API-Verbindung
  test              Fingerabdruck-Dialog testen (ohne Cache)
  reset [--bw]      Auth-Cache löschen (--bw: zusätzlich Bitwarden-Session sperren)
  set-pin           Fallback-PIN festlegen (für FALLBACK_MODE=pin)
  bw-unlock         Bitwarden einmalig entsperren und Session merken
                    (danach genügt der Fingerabdruck)
  map HOST [SUCHE] [password|key|auto]
                    SSH-Host einem Bitwarden-Eintrag zuordnen (interaktive Auswahl)
  repair [--quiet]  Wrapper prüfen und bei Bedarf wiederherstellen (z. B. nach pkg upgrade)
  config [edit]     Pfad der Konfiguration ausgeben bzw. im \$EDITOR öffnen
  log [N]           letzte N Einträge des Audit-Logs (Standard 20)
  version           Version anzeigen
  help              diese Hilfe
EOF
}

_mark() { if [[ $1 == ok ]]; then printf '  [ OK ] '; elif [[ $1 == warn ]]; then printf '  [ !! ] '; else printf '  [FAIL] '; fi; }

_check_cmd() {
    # $1 = Befehl, $2 = Paket/Hinweis, $3 = required|optional
    local p
    if p=$(command -v "$1" 2>/dev/null); then
        _mark ok; printf '%-20s %s\n' "$1" "$p"
    elif [[ $3 == required ]]; then
        _mark fail; printf '%-20s fehlt -> %s\n' "$1" "$2"
    else
        _mark warn; printf '%-20s fehlt (optional) -> %s\n' "$1" "$2"
    fi
}

cmd_status() {
    local live=${1:-false}
    taw_load_config
    printf 'termux-auth-wrapper %s\n\n' "$TAW_VERSION"

    printf 'Installation:\n'
    if inst_read_state "$TAW_LIB_DIR"; then
        printf '  Modus: %s   Wrapper-Verzeichnis: %s\n' "$INST_MODE" "$INST_BIN_DIR"
        local w state resolved real
        for w in $INST_WRAPPERS; do
            state=$(inst_wrapper_state "$w")
            resolved=$(command -v "$w" 2>/dev/null || true)
            real=$(taw_find_real "$w" 2>/dev/null || true)
            [[ $w == sudo ]] && real="(su via KernelSU)"
            if [[ $state == ok && $resolved == "$INST_BIN_DIR/$w" ]]; then
                _mark ok
            else
                _mark warn
            fi
            printf '%-6s Zustand=%s, PATH->%s, echtes Binary=%s\n' "$w" "$state" "${resolved:-nicht gefunden}" "${real:-?}"
            if [[ -n $resolved && $resolved != "$INST_BIN_DIR/$w" ]]; then
                printf '         -> %s steht im PATH vor %s. PATH-Reihenfolge prüfen!\n' "$resolved" "$INST_BIN_DIR"
            fi
            if [[ $state != ok ]]; then
                printf '         -> "termux-auth repair" ausführen\n'
            fi
        done
        if [[ $INST_APT_HOOK == true ]]; then
            if [[ -f $(inst_apt_hook) ]]; then _mark ok; else _mark warn; fi
            printf 'apt-Hook %s\n' "$(inst_apt_hook)"
        fi
    else
        _mark warn; printf 'Kein Installationszustand gefunden (Entwicklungsmodus?)\n'
    fi

    printf '\nAbhängigkeiten:\n'
    _check_cmd termux-fingerprint "pkg install termux-api + App 'Termux:API'" required
    _check_cmd jq "pkg install jq" required
    _check_cmd timeout "pkg install coreutils" required
    _check_cmd sha256sum "pkg install coreutils" optional
    _check_cmd sshpass "pkg install sshpass" optional
    _check_cmd ssh-add "pkg install openssh" optional
    _check_cmd bw "npm install -g @bitwarden/cli" optional

    printf '\nRoot (KernelSU):\n'
    local su=""
    for c in "${TAW_SU_BINARY/#auto/}" /system/bin/su /data/adb/ksu/bin/su /system/xbin/su /sbin/su; do
        [[ -n $c && -x $c ]] && { su=$c; break; }
    done
    if [[ -n $su ]]; then _mark ok; printf 'su gefunden: %s\n' "$su"
    else _mark fail; printf 'kein su gefunden – KernelSU aktiv und Termux freigegeben?\n'; fi
    if [[ $live == true && -n $su ]]; then
        local uid
        if uid=$(timeout 15 "$su" -c 'id -u' </dev/null 2>/dev/null) && [[ $uid == 0 ]]; then
            _mark ok; printf 'su -c funktioniert (uid 0)\n'
        else
            _mark fail; printf 'su -c lieferte kein root – in der KernelSU-App Termux Root-Rechte gewähren\n'
        fi
    fi

    printf '\nKonfiguration: %s%s\n' "$TAW_CONFIG_FILE" "$([[ -f $TAW_CONFIG_FILE ]] || printf ' (fehlt – Standardwerte)')"
    printf '  Auth-Cache: %ss (Scope %s)   Fallback: %s   Biometrie-Timeout: %ss\n' \
        "$TAW_AUTH_CACHE_TIMEOUT" "$TAW_AUTH_CACHE_SCOPE" "$TAW_FALLBACK_MODE" "$TAW_BIO_TIMEOUT"
    printf '  sudo: %s   ssh: %s (Scope %s)   Bitwarden: %s\n' \
        "$TAW_SUDO_ENABLED" "$TAW_SSH_ENABLED" "$TAW_SSH_AUTH_SCOPE" "$TAW_BW_ENABLED"
    if [[ $TAW_FALLBACK_MODE == allow ]]; then
        _mark warn; printf 'FALLBACK_MODE=allow ist UNSICHER\n'
    fi

    if [[ $live == true ]] && taw_is_true "$TAW_BW_ENABLED"; then
        printf '\nBitwarden:\n'
        if command -v bw >/dev/null 2>&1; then
            _taw_bw_load_cached_session || true
            local st
            st=$(taw_bw_status)
            if [[ $st == unlocked ]]; then _mark ok; else _mark warn; fi
            printf 'Status: %s\n' "$st"
        else
            _mark fail; printf 'bw nicht installiert\n'
        fi
    fi
}

# Führt einen Befehl mit Zeitlimit aus; setzt DIAG_OUT und DIAG_RC
_diag_run() {
    local t=$1; shift
    DIAG_RC=0
    DIAG_OUT=$(timeout "$t" "$@" </dev/null 2>&1) || DIAG_RC=$?
}

cmd_diag() {
    taw_load_config
    local v su="" c pkg_ok=true ipc_ok=false
    printf 'Termux:API-Diagnose\n\n'

    printf '1) Termux-App\n'
    printf '   TERMUX_VERSION=%s  TERMUX_APK_RELEASE=%s\n' "${TERMUX_VERSION:-?}" "${TERMUX_APK_RELEASE:-?}"
    if [[ ${TERMUX_APK_RELEASE:-} == GOOGLE_PLAY_STORE ]]; then
        _mark warn; printf 'Termux aus dem Play Store: Termux:API muss ebenfalls aus dem Play Store kommen.\n'
    elif [[ -z ${TERMUX_VERSION:-} ]]; then
        _mark warn; printf 'TERMUX_VERSION fehlt: sehr alte Termux-App (z. B. alter Play-Store-Stand)? Aktuelle Version von F-Droid/GitHub empfohlen.\n'
    fi

    printf '\n2) Paket termux-api\n'
    if v=$(dpkg-query -W -f='${Version}' termux-api 2>/dev/null); then
        _mark ok; printf 'termux-api %s\n' "$v"
    else
        _mark fail; printf 'Paket termux-api nicht installiert -> pkg install termux-api\n'; pkg_ok=false
    fi

    printf '\n3) App com.termux.api (über root, nur lesend)\n'
    for c in "${TAW_SU_BINARY/#auto/}" /system/bin/su /data/adb/ksu/bin/su /system/xbin/su; do
        [[ -n $c && -x $c ]] && { su=$c; break; }
    done
    if [[ -n $su ]]; then
        # shellcheck disable=SC2016  # wird auf der Root-Seite expandiert
        _diag_run 20 "$su" -c 'echo "== users"; pm list users 2>/dev/null; for p in com.termux com.termux.api; do echo "== $p"; dumpsys package $p | grep -E "versionName=|installerPackageName=|User [0-9]+:|installed=|hidden=|suspended=|stopped=|enabled=|isArchived|archiveState" | sed -n 1,12p; done; echo "== pm list packages --user 0"; pm list packages --user 0 2>/dev/null | grep termux; echo "== appops com.termux.api"; cmd appops get com.termux.api 2>/dev/null | grep -E "SYSTEM_ALERT_WINDOW|RUN_ANY_IN_BACKGROUND|RUN_IN_BACKGROUND"; echo "== standby"; am get-standby-bucket com.termux.api 2>/dev/null; true'
        if [[ -n $DIAG_OUT ]]; then
            printf '%s\n' "$DIAG_OUT" | sed 's/^/   /'
            if ! grep -q 'package:com.termux.api' <<<"$(sed -n '/== pm list packages --user 0/,/== appops/p' <<<"$DIAG_OUT")"; then
                _mark fail; printf 'com.termux.api ist für Benutzer 0 NICHT installiert (evtl. nur in einem anderen Profil/Private Space).\n'
                printf '         -> su -c "pm install-existing --user 0 com.termux.api"\n'
            fi
            if ! grep -q 'versionName=' <<<"$(sed -n '/== com.termux.api/,/== appops/p' <<<"$DIAG_OUT")"; then
                _mark fail; printf 'App Termux:API ist NICHT installiert (das Paket termux-api allein reicht nicht).\n'
            fi
            grep -q 'stopped=true' <<<"$DIAG_OUT" && { _mark warn; printf 'Eine App steht auf stopped=true -> Termux:API einmal öffnen bzw. nicht "Beenden erzwingen".\n'; }
            grep -qE 'RUN_ANY_IN_BACKGROUND: (ignore|deny)' <<<"$DIAG_OUT" && { _mark warn; printf 'Hintergrund-Ausführung für Termux:API eingeschränkt -> Akku: "Nicht eingeschränkt".\n'; }
            printf '   Hinweis: installerPackageName von com.termux und com.termux.api sollte übereinstimmen (beide F-Droid ODER beide GitHub/Play).\n'
        else
            _mark warn; printf 'Konnte Paketinfos nicht lesen (rc=%s)\n' "$DIAG_RC"
        fi
    else
        _mark warn; printf 'kein su – übersprungen\n'
    fi

    printf '\n4) IPC-Test ohne Dialog (termux-battery-status, 10s)\n'
    if [[ $pkg_ok == true ]]; then
        _diag_run 10 termux-battery-status
        if [[ $DIAG_RC == 0 && $DIAG_OUT == *"{"* ]]; then
            _mark ok; printf 'Termux:API antwortet -> die Verbindung funktioniert grundsätzlich.\n'; ipc_ok=true
        elif [[ $DIAG_RC == 124 ]]; then
            _mark fail; printf 'Keine Antwort -> Termux:API empfängt gar keine Anfragen.\n'
            printf '         Ursache fast immer: App aus anderer Quelle als Termux (Signatur), App nie geöffnet/zwangsbeendet oder Akku-Einschränkung.\n'
        else
            _mark fail; printf 'rc=%s: %s\n' "$DIAG_RC" "${DIAG_OUT:0:200}"
        fi
    fi

    printf '\n5) termux-fingerprint ohne Optionen (%ss) – bitte jetzt den Sensor berühren\n' "$TAW_BIO_TIMEOUT"
    if [[ $pkg_ok == true ]]; then
        _diag_run "$TAW_BIO_TIMEOUT" termux-fingerprint
        printf '   rc=%s Ausgabe: %s\n' "$DIAG_RC" "${DIAG_OUT:-<leer>}"
        if [[ $DIAG_OUT == *AUTH_RESULT_SUCCESS* ]]; then
            _mark ok; printf 'Fingerabdruck ohne Optionen funktioniert.\n'
            printf '\n6) termux-fingerprint mit -t/-d\n'
            _diag_run "$TAW_BIO_TIMEOUT" termux-fingerprint -t "Diagnose" -d "Test mit Titel"
            printf '   rc=%s Ausgabe: %s\n' "$DIAG_RC" "${DIAG_OUT:-<leer>}"
            if [[ $DIAG_OUT == *AUTH_RESULT_SUCCESS* ]]; then
                _mark ok; printf 'Alles funktioniert.\n'
            else
                _mark warn; printf 'Mit -t/-d klappt es nicht -> in der Konfiguration BIO_DIALOG_TEXT=false setzen.\n'
            fi
        elif [[ $DIAG_RC == 124 && $ipc_ok == true ]]; then
            _mark fail; printf 'Nur der Dialog hängt: Android blockiert vermutlich das Öffnen der Activity.\n'
            printf '         -> Termux:API die Berechtigung "Über anderen Apps einblenden" geben, Termux im Vordergrund lassen,\n'
            printf '            ggf. BIO_TIMEOUT erhöhen. Erscheint der Dialog gar nicht, Termux:API aktualisieren.\n'
        fi
    fi

    printf '\n7) Absturzprotokoll von Termux:API (logcat, über root)\n'
    if [[ -n $su ]]; then
        local crash
        _diag_run 20 "$su" -c 'logcat -d -b crash 2>/dev/null; logcat -d -s AndroidRuntime:E 2>/dev/null'
        crash=$(_extract_crash <<<"$DIAG_OUT")
        if [[ -n $crash ]]; then
            _mark fail; printf 'Termux:API ist abgestürzt. Letzter Absturz:\n'
            printf '%s\n' "$crash" | sed 's/^/   /'
            _crash_hint "$crash"
        else
            _mark ok; printf 'Kein Absturz von com.termux.api im Log gefunden.\n'
        fi
    else
        _mark warn; printf 'kein su – übersprungen. Manuell: logcat -d -b crash (benötigt root/adb)\n'
    fi
}

# Letzten "FATAL EXCEPTION"-Block von com.termux.api aus logcat extrahieren
_extract_crash() {
    awk '
        /FATAL EXCEPTION/ { if (blk != "" && api) last = blk; blk = ""; api = 0; inblk = 1; n = 0 }
        inblk && /AndroidRuntime/ {
            if (n < 40) { line = $0; sub(/^.*AndroidRuntime[^:]*: /, "", line); blk = blk line "\n"; n++ }
            if ($0 ~ /Process: com\.termux\.api/) api = 1
            next
        }
        inblk { if (blk != "" && api) last = blk; inblk = 0 }
        END { if (inblk && blk != "" && api) last = blk; printf "%s", last }'
}

# Hinweise zu bekannten Absturzursachen
_crash_hint() {
    local c=$1
    case $c in
        *"Unable to get package info for com.termux.api"*|*"not installed on user"*)
            printf '         -> Android meldet Termux:API für Benutzer 0 als "nicht installiert", obwohl der Prozess startet.\n'
            printf '            Mögliche Ursachen: App nur in anderem Profil/Private Space, App versteckt/archiviert,\n'
            printf '            oder ein Root-Hiding-Modul (z. B. Hide My Applist, Shamiko, KernelSU-"Module ausblenden")\n'
            printf '            blendet das Paket aus. Prüfen bzw. reparieren (siehe Schritt 3):\n'
            printf '              su -c "pm install-existing --user 0 com.termux.api"\n'
            printf '              su -c "pm unhide com.termux.api; pm unsuspend com.termux.api"\n'
            printf '            Hilft das nicht: Termux:API deinstallieren und die APK neu installieren\n'
            printf '            (su -c "pm install -r --user 0 /pfad/termux-api.apk").\n' ;;
        *SecurityException*|*"Permission Denial"*)
            printf '         -> Berechtigungsproblem: Termux und Termux:API aus derselben Quelle installieren\n'
            printf '            (Signatur) und Termux:API in den App-Infos alle Berechtigungen erlauben.\n' ;;
        *ForegroundServiceStartNotAllowed*|*BackgroundServiceStartNotAllowed*|*"not allowed to start service"*)
            printf '         -> Android verbietet den Hintergrunddienst: Termux:API unter Akku auf "Nicht eingeschränkt" stellen\n'
            printf '            und Termux im Vordergrund lassen.\n' ;;
        *ClassNotFoundException*|*NoSuchMethodError*|*NoClassDefFoundError*)
            printf '         -> Defekte/inkompatible Installation: Termux:API deinstallieren und aus derselben Quelle\n'
            printf '            wie Termux neu installieren, danach: pkg upgrade termux-api\n' ;;
        *)
            printf '         -> Bitte diesen Block melden (z. B. als Issue bei termux/termux-api) oder hier einfügen.\n' ;;
    esac
}

# Fragt auf dem Terminal Ja/Nein (Standard: Ja)
_ask_yes() {
    local answer
    taw_have_tty || return 1
    printf '%s [J/n] ' "$1" >/dev/tty
    IFS= read -r answer </dev/tty || answer=n
    case ${answer,,} in ""|j|ja|y|yes) return 0 ;; *) return 1 ;; esac
}

cmd_bw_unlock() {
    taw_load_config
    taw_bw_require || exit 1
    if ! taw_is_true "$TAW_BW_SESSION_CACHE"; then
        taw_info "Damit das Master-Passwort nur EINMAL nötig ist, muss die Bitwarden-Session gespeichert werden"
        taw_hint "(Datei $_TAW_BW_SESSION_FILE, 0600; gültig bis 'termux-auth reset --bw' bzw. 'bw lock')."
        if _ask_yes "BW_SESSION_CACHE=true setzen?"; then
            _config_set BW_SESSION_CACHE true
            TAW_BW_SESSION_CACHE=true
        else
            taw_warn "Session wird nicht gespeichert – das Master-Passwort wird bei jedem gesperrten Tresor erneut abgefragt."
        fi
    fi
    taw_authenticate bw "Bitwarden entsperren" || taw_die "Authentifizierung fehlgeschlagen."
    TAW_BW_UNLOCK_MODE=prompt
    taw_bw_ensure_unlocked || exit 1
    if ! taw_is_true "$TAW_BW_ENABLED"; then
        _config_set BW_ENABLED true
        taw_info "BW_ENABLED=true gesetzt."
    fi
    taw_ok "Bitwarden ist entsperrt. Ab jetzt genügt der Fingerabdruck."
}

cmd_map() {
    local host=${1:-} search=${2:-${1:-}} type=${3:-auto} items count choice id name
    [[ -n $host ]] || taw_die "Aufruf: termux-auth map HOST [SUCHBEGRIFF] [password|key|auto]"
    [[ $host != *[[:space:]]* ]] || taw_die "HOST darf keine Leerzeichen enthalten."
    case $type in password|key|auto) ;; *) taw_die "Ungültiger Typ '$type' (password|key|auto)." ;; esac
    taw_load_config
    taw_bw_require || exit 1
    taw_authenticate bw "Bitwarden-Eintrag für $host auswählen" || taw_die "Authentifizierung fehlgeschlagen."
    taw_bw_ensure_unlocked || exit 1

    items=$(_taw_bw list items --search "$search" 2>/dev/null) || taw_die "Bitwarden-Suche nach '$search' fehlgeschlagen."
    count=$(jq 'length' <<<"$items" 2>/dev/null || echo 0)
    (( count > 0 )) || taw_die "Keine Bitwarden-Einträge zu '$search' gefunden (anderer Suchbegriff als 2. Argument?)."

    jq -r 'to_entries[] | "  \(.key + 1)) \(.value.name)  [\(.value.login.username // "-")]  \(
        if .value.sshKey.privateKey then "SSH-Schlüssel" elif .value.login.password then "Passwort" else "kein Geheimnis" end)"' <<<"$items" >&2
    if (( count == 1 )); then
        choice=1
    else
        taw_have_tty || taw_die "Mehrere Treffer und kein Terminal zur Auswahl – Suchbegriff präzisieren."
        printf 'Eintrag wählen [1-%s]: ' "$count" >/dev/tty
        IFS= read -r choice </dev/tty || choice=""
    fi
    if ! taw_is_uint "$choice" || (( 10#$choice < 1 || 10#$choice > count )); then
        taw_die "Ungültige Auswahl."
    fi
    choice=$((10#$choice))
    id=$(jq -r ".[$((choice - 1))].id" <<<"$items")
    name=$(jq -r ".[$((choice - 1))].name" <<<"$items" | tr -d '\n#')
    items=""

    taw_ensure_dir "$(dirname "$TAW_HOSTS_FILE")" 700
    [[ -f $TAW_HOSTS_FILE ]] || : >"$TAW_HOSTS_FILE"
    local tmp="$TAW_HOSTS_FILE.tmp.$$"
    awk -v h="$host" '$1 != h' "$TAW_HOSTS_FILE" >"$tmp"
    printf '%-24s %s  %s  # %s\n' "$host" "$id" "$type" "$name" >>"$tmp"
    chmod 600 "$tmp"
    mv -f "$tmp" "$TAW_HOSTS_FILE"
    taw_ok "Zugeordnet: $host -> \"$name\" ($type) in $TAW_HOSTS_FILE"

    if ! taw_is_true "$TAW_BW_ENABLED"; then
        _config_set BW_ENABLED true
        taw_info "BW_ENABLED=true gesetzt."
    fi
    if [[ $type != key ]] && ! command -v sshpass >/dev/null 2>&1; then
        taw_warn "Für Passwort-Logins wird sshpass benötigt: pkg install sshpass"
    fi
    if ! taw_is_true "$TAW_BW_SESSION_CACHE"; then
        taw_hint "Tipp: 'termux-auth bw-unlock' – dann ist das Master-Passwort nur einmal nötig."
    fi
    taw_hint "Testen mit: ssh $host"
}

cmd_set_pin() {
    taw_load_config
    taw_have_tty || taw_die "set-pin benötigt ein Terminal."
    local p1 p2 salt hash
    printf 'Neue Fallback-PIN (mind. 4 Zeichen): ' >/dev/tty
    IFS= read -r -s p1 </dev/tty; printf '\n' >/dev/tty
    printf 'PIN wiederholen: ' >/dev/tty
    IFS= read -r -s p2 </dev/tty; printf '\n' >/dev/tty
    [[ $p1 == "$p2" ]] || taw_die "Eingaben stimmen nicht überein."
    (( ${#p1} >= 4 )) || taw_die "PIN zu kurz."
    salt=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')
    hash=$(taw_pin_hash "$salt" "$p1")
    p1="" p2=""
    _config_set FALLBACK_PIN_HASH "sha256:$salt:$hash"
    taw_ok "PIN gespeichert in $TAW_CONFIG_FILE"
    [[ $TAW_FALLBACK_MODE == pin ]] || taw_hint "Zum Aktivieren in der Konfiguration setzen: FALLBACK_MODE=pin"
}

# Setzt KEY="wert" in der Konfigurationsdatei (ersetzt bzw. ergänzt)
_config_set() {
    local key=$1 value=$2 f=$TAW_CONFIG_FILE tmp
    taw_ensure_dir "$(dirname "$f")" 700
    [[ -f $f ]] || : >"$f"
    tmp="$f.tmp.$$"
    awk -v k="$key" -v v="$value" '
        BEGIN { done = 0 }
        $0 ~ "^[[:space:]]*#?[[:space:]]*" k "[[:space:]]*=" && !done { print k "=\"" v "\""; done = 1; next }
        { print }
        END { if (!done) print k "=\"" v "\"" }' "$f" >"$tmp"
    chmod 600 "$tmp"
    mv -f "$tmp" "$f"
}

cmd_repair() {
    local quiet=false w state changed=0
    [[ ${1:-} == --quiet || ${1:-} == -q ]] && quiet=true
    [[ $quiet == true ]] && TAW_QUIET=true
    inst_read_state "$TAW_LIB_DIR" || taw_die "Kein Installationszustand gefunden – bitte install.sh ausführen."
    for w in $INST_WRAPPERS; do
        state=$(inst_wrapper_state "$w")
        if [[ $state == ok ]]; then
            taw_info "$w: in Ordnung"
            continue
        fi
        # Bei "replaced" immer melden – das deutet auf ein Paket-Update hin
        [[ $quiet == true ]] && printf '[termux-auth] %s: Zustand "%s" – wird repariert\n' "$w" "$state" >&2
        inst_place_wrapper "$w"
        taw_ok "$w: repariert ($state)"
        changed=$((changed + 1))
    done
    if [[ $INST_APT_HOOK == true && ! -f $(inst_apt_hook) ]]; then
        inst_install_apt_hook
        changed=$((changed + 1))
    fi
    (( changed == 0 )) && taw_info "Nichts zu tun."
    return 0
}

cmd_log() {
    taw_load_config
    local n=${1:-20} log="$TAW_STATE_DIR/audit.log"
    taw_is_uint "$n" || taw_die "Ungültige Anzahl: $n"
    [[ -f $log ]] || { taw_info "Noch kein Audit-Log vorhanden ($log)."; return 0; }
    tail -n "$n" "$log"
}

main() {
    local subcmd=${1:-help}
    (($#)) && shift
    case $subcmd in
        status)  cmd_status false ;;
        doctor)  cmd_status true ;;
        diag)    cmd_diag ;;
        test)
            taw_load_config
            if taw_biometric_check "Test von termux-auth-wrapper"; then
                taw_ok "$TAW_BIO_REASON"
            else
                printf 'Status: %s\n' "$TAW_BIO_STATUS" >&2
                exit 1
            fi ;;
        reset|lock)
            taw_load_config
            taw_cache_clear_all
            taw_ok "Auth-Cache gelöscht."
            if [[ ${1:-} == --bw ]]; then
                taw_bw_forget_session
                if command -v bw >/dev/null 2>&1; then
                    bw lock >/dev/null 2>&1 </dev/null || true
                fi
                taw_ok "Bitwarden-Session verworfen."
            fi ;;
        set-pin) cmd_set_pin ;;
        bw-unlock) cmd_bw_unlock ;;
        map)     cmd_map "$@" ;;
        repair)  cmd_repair "$@" ;;
        config)
            taw_load_config
            if [[ ${1:-} == edit ]]; then
                exec "${EDITOR:-nano}" "$TAW_CONFIG_FILE"
            fi
            printf '%s\n%s\n' "$TAW_CONFIG_FILE" "$TAW_HOSTS_FILE" ;;
        log)     cmd_log "$@" ;;
        version|-V|--version) printf 'termux-auth-wrapper %s\n' "$TAW_VERSION" ;;
        help|-h|--help) usage ;;
        *) taw_err "Unbekannter Befehl: $subcmd"; usage >&2; exit 1 ;;
    esac
}

main "$@"
